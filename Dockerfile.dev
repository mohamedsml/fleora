# Image de développement local uniquement.
# Reproduit l'environnement PHP de Hostinger Cloud Startup :
# PHP 8.3 + pdo_mysql + gd/imagick + intl + zip + bcmath.
# La production n'utilise PAS Docker — l'hébergement fournit déjà ces extensions.
FROM php:8.3-cli

RUN apt-get update && apt-get install -y --no-install-recommends \
        libfreetype6-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
        libicu-dev libzip-dev libmagickwand-dev git unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql gd intl zip bcmath exif \
    && pecl install imagick \
    && docker-php-ext-enable imagick \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
