# ─── Secrets ─────────────────────────────────────────────────────────────
# Jamais dans Git : mots de passe de base de données, clé d'application,
# identifiants SMTP. Un secret poussé une fois reste dans l'historique même
# après suppression — il faut alors le considérer comme compromis et le changer.
.env
.env.*
!.env.example
auth.json
*.key
*.pem

# ─── Dépendances (réinstallables) ────────────────────────────────────────
# Reconstruites par `composer install` / `npm install` à partir des fichiers
# de verrouillage, qui eux SONT versionnés.
vendor/
node_modules/

# ─── Build et compilation ────────────────────────────────────────────────
# public/build/ est VOLONTAIREMENT versionné : l'hébergement mutualisé
# n'exécute pas Node, les assets sont donc compilés en local (npm run build)
# et déployés avec le code. Les ignorer casserait les styles en production.
public/hot
public/storage

# ─── Laravel : fichiers d'exécution ──────────────────────────────────────
# Le contenu de storage est généré à l'exécution (logs, cache, sessions).
# L'arborescence, elle, doit exister : voir les .gitignore internes de Laravel.
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
/storage/app/public/*
/storage/pail
/bootstrap/cache/*.php

# ─── Tests ───────────────────────────────────────────────────────────────
.phpunit.result.cache
.phpunit.cache/
coverage/

# ─── Éditeurs et OS ──────────────────────────────────────────────────────
.idea/
.vscode/
.zed/
.nova/
.cursor/
.codex/
.phpactor.json
_ide_helper.php
.DS_Store
Thumbs.db
*.log
