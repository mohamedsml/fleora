APP_NAME=Fleora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Toronto
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB en local (Docker Compose) comme en production (Hostinger).
#
# EN LOCAL : rien à changer. docker/compose.yaml impose DB_HOST=db et le
#            conteneur crée la base avec root/dev.
#
# EN PRODUCTION : remplacer les quatre valeurs par celles de hPanel →
#            Bases de données. Le nom de la base ET l'utilisateur commencent
#            par votre préfixe de compte (ex. u123456_fleora).
#            DB_HOST reste « localhost ».
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=A_REMPLACER_uXXXXXX_fleora
DB_USERNAME=A_REMPLACER_uXXXXXX_fleora
DB_PASSWORD=A_REMPLACER

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie de session transmis uniquement en HTTPS.
# ⚠️ true EN PRODUCTION : sans cela, le cookie circule en clair sur une
# connexion HTTP et peut être intercepté. Laissé à false en développement local,
# qui n'a pas de certificat.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connexion automatique à /admin, pour éviter de ressaisir le mot de passe à
# chaque session de développement.
#
# ⚠️ NE JAMAIS ACTIVER EN PRODUCTION : l'administration (demandes clientes,
# devis, factures) deviendrait accessible sans authentification. Le middleware
# refuse de fonctionner si APP_ENV ≠ local, mais la vraie protection est de ne
# pas mettre cette ligne dans le .env du serveur.
FLEORA_AUTO_LOGIN=false

# Cloudflare Turnstile — protection anti-robots du formulaire.
# Clés gratuites sur https://dash.cloudflare.com → Turnstile.
# Laissées vides, le widget ne s'affiche pas et la validation est ignorée : le
# formulaire reste protégé par le honeypot, le délai minimal et la limite par IP.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
